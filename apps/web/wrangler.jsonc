{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elafda-web-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "env": {
    "production": {
      "name": "elafda-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "elafda.org",
          "custom_domain": true
        },
        {
          "pattern": "www.elafda.org",
          "custom_domain": true
        }
      ]
    }
  }
}
