{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elafda-web-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // The bot Worker's namespace (apps/bot/wrangler.jsonc). The web Worker only
  // lists `tagged:` keys from it to serve /api/tagged; the bot stays the sole
  // writer and keeps no HTTP surface of its own.
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "7ce70e7ccc8c40fbaa8e56c7f3c1a97e"
    }
  ],
  "env": {
    "production": {
      "name": "elafda-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "elafda.org",
          "custom_domain": true
        },
        {
          "pattern": "www.elafda.org",
          "custom_domain": true
        }
      ],
      // kv_namespaces is per-environment in Wrangler and does not inherit.
      "kv_namespaces": [
        {
          "binding": "BOT_STATE",
          "id": "7ce70e7ccc8c40fbaa8e56c7f3c1a97e"
        }
      ]
    }
  }
}
