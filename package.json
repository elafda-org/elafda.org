{
  "name": "elafda",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:production": "npm --prefix apps/web run build:production",
    "preview": "npm --prefix apps/web run preview",
    "deploy:preview": "npm --prefix apps/web run deploy:preview",
    "deploy:production": "npm --prefix apps/web run deploy:production",
    "test": "npm run typecheck:domain && npm run typecheck:bot && npm run test:domain && npm run test:bot && npm --prefix apps/web test",
    "test:domain": "node --experimental-strip-types --test \"packages/domain/tests/*.test.mjs\"",
    "test:bot": "node --experimental-strip-types --test \"apps/bot/tests/*.test.mjs\"",
    "typecheck:domain": "apps/web/node_modules/.bin/tsc --project packages/domain",
    "typecheck:bot": "apps/web/node_modules/.bin/tsc --project apps/bot",
    "verify:bot-credentials": "node --experimental-strip-types apps/bot/scripts/verify-credentials.mjs",
    "preview:bot-mentions": "node --experimental-strip-types apps/bot/scripts/preview-mentions.mjs",
    "lint": "npm --prefix apps/web run lint"
  }
}
